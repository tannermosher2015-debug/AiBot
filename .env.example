# Copy this file to ".env" and fill it in. Never commit the real .env.
#
# Only ANTHROPIC_API_KEY is required to get a reply out of the bot. Everything
# else is optional in the sense that the code runs without it, but LEAD DELIVERY
# FAILS SILENTLY when it is missing: lib/leads.js falls back to console.log, so
# on Render the lead lands in a log nobody reads and nothing looks broken.
# That is the expensive failure. Set the lead vars on every real install.

# ---- Required ----------------------------------------------------------
# https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Lead delivery: set these or leads are logged and lost --------------
# Resend API key. Without it, no email is sent.
RESEND_API_KEY=re_your-key-here
# Where captured leads are emailed. Without it, no email is sent.
LEAD_NOTIFY_EMAIL=you@yourdomain.com
# Verified Resend sender. Defaults to leads@frontlinewebdesign.tech.
LEAD_FROM_EMAIL=leads@frontlinewebdesign.tech

# ---- Booking link the bot hands out ------------------------------------
# Your Cal.com or Calendly URL. If unset, the bot captures the lead but has
# no link to offer, which makes the conversation end weakly.
BOOKING_URL=https://cal.com/your-handle

# ---- Which persona this deploy serves ----------------------------------
# Key from the AGENTS registry in lib/agents.js: dayna | frontline | frontline-smb
# Defaults to "dayna" if unset, which is a DIFFERENT CLIENT'S persona. Always
# set this explicitly on a real deploy.
BOT_AGENT=frontline-smb

# ---- CORS: which sites may call this backend ---------------------------
# Comma-separated origins, no trailing slash. FAILS CLOSED: if unset, every
# cross-origin browser call is refused and the widget will not work on your
# site. Include every domain that embeds the widget.
ALLOWED_ORIGINS=https://frontlinewebdesign.tech,https://www.frontlinewebdesign.tech

# ---- Real Cal.com booking: OFF unless BOTH of these are set ------------
# With these unset the bot keeps its honest fallback: it captures the lead,
# hands over BOOKING_URL, and never claims a time is held. Set BOTH to let it
# read real availability and make real reservations. Half-set counts as OFF.
# Key: Cal.com -> Settings -> Developer -> API keys.
CALCOM_API_KEY=cal_live_your-key-here
# Numeric id of the event type to book into (in the event type's URL).
CALCOM_EVENT_TYPE_ID=123456
# IANA timezone for slots and bookings. Defaults to Pacific/Honolulu.
CALCOM_TIMEZONE=Pacific/Honolulu

# ---- Optional ----------------------------------------------------------
# PORT=3000
